{
  "name": "cliniccare",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node tests/smoke.mjs",
    "guard": "node .eslint-guard.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "ioredis": "^5.6.0",
    "next": "16.3.6",
    "pino": "^9.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@prisma/client": "^6.12.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.6.0",
    "prisma": "^6.12.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.0",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
