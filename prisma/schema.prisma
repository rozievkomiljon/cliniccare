// ClinicCare — schema. Phases extend this file with additive migrations only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Clinics are the tenant boundary. Every clinic-scoped table carries clinicId.
model Clinic {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  timezone  String   @default("UTC")
  settings  Json     @default("{}")
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships    Membership[]
  auditLogs      AuditLog[]
  patients       Patient[]
  services       ServiceCatalogItem[]
  doctorProfiles DoctorProfile[]
  appointments   Appointment[]
  notifications  Notification[]
  encounters     Encounter[]
  clinicalNotes  ClinicalNote[]
  vitals         Vital[]

  @@index([slug])
}

enum Role {
  SUPER_ADMIN
  CLINIC_ADMIN
  RECEPTIONIST
  DOCTOR
  NURSE
  LAB_TECH
  PHARMACIST
  ACCOUNTANT
  PATIENT
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  name              String
  phone             String?
  isSuperAdmin      Boolean   @default(false)
  isActive          Boolean   @default(true)
  emailVerifiedAt   DateTime?
  /// Set on logout-all/password-reset; JWTs issued before this instant are invalid.
  sessionsRevokedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  memberships             Membership[]
  sessions                Session[]
  accounts                Account[]
  auditLogs               AuditLog[]               @relation("AuditActor")
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  patientAccount          PatientAccount?
  uploadedAttachments     Attachment[]             @relation("AttachmentUploader")
  doctorProfile           DoctorProfile?
  notifications           Notification[]

  @@index([isActive])
}

/// Single-use, hashed, expiring tokens for the password-reset flow.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Single-use, hashed, expiring tokens for email verification.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// User <-> Clinic membership with the clinic-scoped role (M:N).
model Membership {
  id       String @id @default(cuid())
  userId   String
  clinicId String
  role     Role

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([userId, clinicId])
  @@index([clinicId, role])
}

/// Auth.js session row (kept for adapter compatibility / future device list).
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Placeholder for Auth.js OAuth accounts; credentials-only for now.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Append-only audit trail. Never updated, never hard-deleted.
model AuditLog {
  id          String   @id @default(cuid())
  clinicId    String?
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  before      Json?
  after       Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  clinic Clinic? @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  actor  User?   @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@index([clinicId, createdAt])
}

enum Sex {
  MALE
  FEMALE
  OTHER
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  UNKNOWN
}

/// Clinic-scoped patient registry — the core clinical entity.
model Patient {
  id                    String      @id @default(cuid())
  clinicId              String
  /// Human-friendly medical record number, unique per clinic.
  mrn                   String
  firstName             String
  lastName              String
  dateOfBirth           DateTime
  sex                   Sex
  phone                 String?
  email                 String?
  address               String?
  city                  String?
  emergencyContactName  String?
  emergencyContactPhone String?
  bloodGroup            BloodGroup?
  allergies             String?
  chronicConditions     String?
  notes                 String?
  isDeleted             Boolean     @default(false)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  clinic        Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  portalAccount PatientAccount?
  attachments   Attachment[]
  appointments  Appointment[]
  notifications Notification[]
  encounters    Encounter[]
  clinicalNotes ClinicalNote[]
  vitals        Vital[]

  @@unique([clinicId, mrn])
  @@index([clinicId, isDeleted, lastName])
  @@index([clinicId, isDeleted, phone])
  @@index([lastName, firstName])
}

/// Links a portal login (User) to exactly one clinical Patient record.
model PatientAccount {
  id        String   @id @default(cuid())
  userId    String   @unique
  patientId String   @unique
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

/// Patient documents (IDs, referrals, scans). Bytes live in the private
/// object store; this row holds only metadata + the storage key.
model Attachment {
  id           String   @id @default(cuid())
  clinicId     String
  patientId    String
  /// Server-generated object key inside the private bucket (never client-supplied).
  storageKey   String   @unique
  fileName     String
  contentType  String
  sizeBytes    Int
  description  String?
  uploadedById String
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patient    Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation("AttachmentUploader", fields: [uploadedById], references: [id])

  @@index([patientId, isDeleted])
}

/// Billing service catalog (seeded with consultation prices for later phases).
model ServiceCatalogItem {
  id        String   @id @default(cuid())
  clinicId  String
  name      String
  category  String   @default("CONSULTATION")
  unitPrice Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, category])
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

/// Who changed an appointment and why — drives the patient-visible feed.
enum AppointmentActorKind {
  STAFF
  PATIENT
}

enum NotificationType {
  APPOINTMENT_BOOKED
  APPOINTMENT_RESCHEDULED
  APPOINTMENT_CANCELLED
}

/// Clinical staff identity: specialization and booking constraints. One per
/// User, created by clinic admins; booking services resolve schedules via it.
model DoctorProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  clinicId       String
  specialization String
  bio            String?
  licenseNo      String?
  isDeleted      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic       Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  schedules    DoctorSchedule[]
  timeOff      DoctorTimeOff[]
  appointments Appointment[]    @relation("AppointmentDoctor")
  encounters   Encounter[]      @relation("EncounterDoctor")

  @@index([clinicId, isDeleted])
}

/// One weekly availability row per weekday. Times are minutes from midnight.
model DoctorSchedule {
  id          String  @id @default(cuid())
  doctorId    String
  /// 0=Sunday … 6=Saturday (JS getUTCDay convention).
  weekday     Int
  startMinute Int
  endMinute   Int
  slotMinutes Int     @default(30)
  isDeleted   Boolean @default(false)

  doctor DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, weekday])
}

/// Clinic-admin-entered absences (leave, conference); validated to not overlap
/// (except full-day) in the service layer.
model DoctorTimeOff {
  id        String   @id @default(cuid())
  doctorId  String
  startsAt  DateTime
  endsAt    DateTime
  reason    String?
  isFullDay Boolean  @default(false)
  createdAt DateTime @default(now())

  doctor DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, startsAt])
}

/// A visit booked into one doctor's slot. Clinic-scoped; scheduling decisions
/// key on scheduledAt + durationMinutes, so the table itself stays timezone-
/// agnostic (the clinic timezone is display-only).
model Appointment {
  id                 String            @id @default(cuid())
  clinicId           String
  doctorId           String
  patientId          String
  /// Instant the visit starts (stored UTC).
  scheduledAt        DateTime
  /// Planned visit length in minutes; the partial unique index below treats
  /// an overlap as doctor+scheduledAt equality for active statuses.
  durationMinutes    Int               @default(30)
  status             AppointmentStatus @default(PENDING)
  reason             String?
  notes              String?
  /// Set when the appointment leaves the active set (cancel / no-show paths).
  cancelledAt        DateTime?
  cancellationReason String?
  createdById        String?
  createdByName      String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  clinic  Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctor  DoctorProfile      @relation("AppointmentDoctor", fields: [doctorId], references: [id], onDelete: Cascade)
  patient Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  events    AppointmentEvent[]
  encounter Encounter?

  @@index([clinicId, scheduledAt])
  @@index([doctorId, scheduledAt])
  @@index([patientId, scheduledAt])
}

/// Append-only change log for one appointment; also the template for the
/// patient-visible portal feed.
model AppointmentEvent {
  id            String               @id @default(cuid())
  appointmentId String
  kind          AppointmentActorKind
  actorUserId   String?
  actorName     String
  /// free-form: BOOKED / RESCHEDULED / CANCELLED / STATUS / NOTE
  type          String
  detail        String?
  createdAt     DateTime             @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId, createdAt])
}

/// In-app notification. patientId is the portal recipient (for appointment
/// changes); staff recipients ride on the same table via userId.
model Notification {
  id        String           @id @default(cuid())
  clinicId  String
  userId    String?
  patientId String?
  type      NotificationType
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  clinic  Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient Patient? @relation(fields: [patientId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clinicId, patientId, createdAt])
  @@index([userId, readAt])
}

// ---------------------------------------------------------------------------
// Phase 4 — medical records. Clinical rows are append-only (see AGENTS rule 7):
// an Encounter is editable only while OPEN, and everything else is written once.
// ---------------------------------------------------------------------------

enum EncounterKind {
  CONSULTATION
  FOLLOW_UP
  PROCEDURE
  TELEHEALTH
}

enum EncounterStatus {
  OPEN
  SIGNED
}

enum ClinicalNoteKind {
  NOTE
  ADDENDUM
  PROCEDURE
}

/// One clinical visit. While OPEN the author may still correct it; signing is
/// one-way and locks the field set, so later corrections must arrive as an
/// addendum note instead of a silent edit.
model Encounter {
  id             String          @id @default(cuid())
  clinicId       String
  patientId      String
  doctorId       String?
  /// The visit this encounter documents, when it came from the calendar.
  appointmentId  String?         @unique
  /// Instant the encounter happened (stored UTC).
  occurredAt     DateTime
  kind           EncounterKind   @default(CONSULTATION)
  chiefComplaint String?
  diagnosis      String?
  plan           String?
  status         EncounterStatus @default(OPEN)
  signedAt       DateTime?
  signedByUserId String?
  signedByName   String?
  createdById    String
  createdByName  String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  clinic      Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient     Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor      DoctorProfile? @relation("EncounterDoctor", fields: [doctorId], references: [id], onDelete: SetNull)
  appointment Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  notes       ClinicalNote[]
  vitals      Vital[]

  @@index([clinicId, occurredAt])
  @@index([patientId, occurredAt])
  @@index([doctorId, occurredAt])
}

/// Append-only narrative on an encounter (or directly on the record). Rows are
/// never updated or deleted — a correction is a new addendum row.
model ClinicalNote {
  id           String           @id @default(cuid())
  clinicId     String
  patientId    String
  encounterId  String?
  kind         ClinicalNoteKind @default(NOTE)
  body         String
  authorUserId String
  authorName   String
  createdAt    DateTime         @default(now())

  clinic    Clinic     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient   Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounter Encounter? @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([clinicId, patientId, createdAt])
  @@index([encounterId, createdAt])
}

/// Append-only observation set — one row per recording session. Every field is
/// optional so a partial set (blood pressure only, say) is storable.
model Vital {
  id             String   @id @default(cuid())
  clinicId       String
  patientId      String
  encounterId    String?
  recordedAt     DateTime @default(now())
  systolic       Int?
  diastolic      Int?
  pulse          Int?
  temperature    Float?
  spo2           Int?
  weightKg       Float?
  heightCm       Float?
  notes          String?
  recordedById   String
  recordedByName String
  createdAt      DateTime @default(now())

  clinic    Clinic     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient   Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounter Encounter? @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([clinicId, patientId, recordedAt])
  @@index([encounterId, recordedAt])
}
