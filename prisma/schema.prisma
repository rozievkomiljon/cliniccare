// ClinicCare — schema. Phases extend this file with additive migrations only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Clinics are the tenant boundary. Every clinic-scoped table carries clinicId.
model Clinic {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  timezone  String   @default("UTC")
  settings  Json     @default("{}")
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  auditLogs   AuditLog[]
  patients    Patient[]
  services    ServiceCatalogItem[]

  @@index([slug])
}

enum Role {
  SUPER_ADMIN
  CLINIC_ADMIN
  RECEPTIONIST
  DOCTOR
  NURSE
  LAB_TECH
  PHARMACIST
  ACCOUNTANT
  PATIENT
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  name              String
  phone             String?
  isSuperAdmin      Boolean   @default(false)
  isActive          Boolean   @default(true)
  emailVerifiedAt   DateTime?
  /// Set on logout-all/password-reset; JWTs issued before this instant are invalid.
  sessionsRevokedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  memberships             Membership[]
  sessions                Session[]
  accounts                Account[]
  auditLogs               AuditLog[]               @relation("AuditActor")
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  patientAccount          PatientAccount?
  uploadedAttachments     Attachment[]             @relation("AttachmentUploader")

  @@index([isActive])
}

/// Single-use, hashed, expiring tokens for the password-reset flow.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Single-use, hashed, expiring tokens for email verification.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// User <-> Clinic membership with the clinic-scoped role (M:N).
model Membership {
  id       String @id @default(cuid())
  userId   String
  clinicId String
  role     Role

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([userId, clinicId])
  @@index([clinicId, role])
}

/// Auth.js session row (kept for adapter compatibility / future device list).
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Placeholder for Auth.js OAuth accounts; credentials-only for now.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Append-only audit trail. Never updated, never hard-deleted.
model AuditLog {
  id          String   @id @default(cuid())
  clinicId    String?
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  before      Json?
  after       Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  clinic Clinic? @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  actor  User?   @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@index([clinicId, createdAt])
}

enum Sex {
  MALE
  FEMALE
  OTHER
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  UNKNOWN
}

/// Clinic-scoped patient registry — the core clinical entity.
model Patient {
  id                    String      @id @default(cuid())
  clinicId              String
  /// Human-friendly medical record number, unique per clinic.
  mrn                   String
  firstName             String
  lastName              String
  dateOfBirth           DateTime
  sex                   Sex
  phone                 String?
  email                 String?
  address               String?
  city                  String?
  emergencyContactName  String?
  emergencyContactPhone String?
  bloodGroup            BloodGroup?
  allergies             String?
  chronicConditions     String?
  notes                 String?
  isDeleted             Boolean     @default(false)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  clinic        Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  portalAccount PatientAccount?
  attachments   Attachment[]

  @@unique([clinicId, mrn])
  @@index([clinicId, isDeleted, lastName])
  @@index([clinicId, isDeleted, phone])
  @@index([lastName, firstName])
}

/// Links a portal login (User) to exactly one clinical Patient record.
model PatientAccount {
  id        String   @id @default(cuid())
  userId    String   @unique
  patientId String   @unique
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

/// Patient documents (IDs, referrals, scans). Bytes live in the private
/// object store; this row holds only metadata + the storage key.
model Attachment {
  id           String   @id @default(cuid())
  clinicId     String
  patientId    String
  /// Server-generated object key inside the private bucket (never client-supplied).
  storageKey   String   @unique
  fileName     String
  contentType  String
  sizeBytes    Int
  description  String?
  uploadedById String
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patient    Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation("AttachmentUploader", fields: [uploadedById], references: [id])

  @@index([patientId, isDeleted])
}

/// Billing service catalog (seeded with consultation prices for later phases).
model ServiceCatalogItem {
  id        String   @id @default(cuid())
  clinicId  String
  name      String
  category  String   @default("CONSULTATION")
  unitPrice Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, category])
}
