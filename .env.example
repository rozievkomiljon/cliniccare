# Database (Postgres) — compose exposes 5432; change the host port if you already run Postgres locally.
DATABASE_URL="postgresql://cliniccare:cliniccare@localhost:5432/cliniccare"

# Redis (compose exposes 6379)
REDIS_URL="redis://localhost:6379"

# Node environment: development | test | production
NODE_ENV="development"

# Logging: debug | info | warn | error
LOG_LEVEL="info"

# Public base URL of the app (used later for email links)
APP_URL="http://localhost:3000"

# Session signing secret — generate with: openssl rand -base64 32
AUTH_SECRET=""

# SMTP (defaults match the MailHog container in docker/compose.yml)
MAIL_HOST="localhost"
MAIL_PORT="1025"
MAIL_SECURE="false"

# Private object storage (S3 API — MinIO in dev). Never expose buckets publicly.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="cliniccare-documents"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
MAX_UPLOAD_MB="10"
# Private document storage backend: "fs" (local dev/E2E) or "s3" (MinIO/AWS S3).
STORAGE_DRIVER="fs"
DATA_DIR=".data/objects"
